{
  "name": "ontara",
  "version": "0.1.0",
  "description": "Local-first desktop environment for modeling and maintaining fictional universes.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Sxnnyside Project",
    "url": "https://github.com/sxnnyside-project"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxnnyside-project/ontara.git"
  },
  "homepage": "https://github.com/sxnnyside-project/ontara#readme",
  "bugs": {
    "url": "https://github.com/sxnnyside-project/ontara/issues"
  },
  "keywords": [
    "worldbuilding",
    "narrative",
    "tauri",
    "svelte",
    "local-first"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "bun test",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome lint . && ls-lint",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "clean": "rm -rf dist",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@iconify-json/mingcute": "^1.2.8",
    "@ls-lint/ls-lint": "2.3.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.2",
    "@types/bun": "1.4.3",
    "husky": "9.1.7",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "unocss": "^66.11.0",
    "vite": "8.3.4"
  }
}
